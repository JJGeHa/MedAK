# Copy to .env.local. For local development: npm run db:start, then npx supabase status.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from supabase status>
# Encrypts every workspace's data key. 32 random bytes in base64: openssl rand -base64 32
# Never commit this. Losing it makes all saved cases unreadable, so back it up separately.
MEDAK_MASTER_KEY=
