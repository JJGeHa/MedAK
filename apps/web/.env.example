# Copy to .env.local. For local development: npm run db:start, then npx supabase status.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from supabase status>
# Encrypts every workspace's data key. 32 random bytes in base64: openssl rand -base64 32
# Never commit this. Losing it makes all saved cases unreadable, so back it up separately.
MEDAK_MASTER_KEY=
# Optional sign-in methods, shown only once they are set up in Supabase (see docs/security.md).
# NEXT_PUBLIC_MEDAK_OAUTH=google,azure
# NEXT_PUBLIC_MEDAK_SSO=1
# Shown on the landing page for people interested in the paid version. Without it, the page links to GitHub.
# MEDAK_CONTACT_EMAIL=
# Set to 0 until Supabase sends through your own email provider: its default emails have no code.
# NEXT_PUBLIC_MEDAK_EMAIL_CODES=0
